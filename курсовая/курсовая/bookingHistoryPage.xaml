<Page x:Class="курсовая.bookingHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:курсовая"
      mc:Ignorable="d" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      hc:WindowAttach.IsDragElement="False"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="История бронирования"
      FontFamily="pack://application:,,,/Fonts/#Chiron GoRound TC">

    <Grid>

        <StackPanel>

            <TextBlock Text="История бронирования"
                       HorizontalAlignment="Center"
                       FontSize="55"
                       Margin="0 100"
                       FontWeight="Medium"
                       Foreground="#e490a5"/>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center">

                <hc:TextBox x:Name="searchBookingTB"
                            Height="50"
                            Width="1000"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            hc:InfoElement.Placeholder="Поиск"
                            FontSize="20"
                            TextChanged="searchBookingTB_TextChanged"/>

                <Grid>
                    <ComboBox x:Name="filtersCB" 
                              Height="50"
                              VerticalAlignment="Top"
                              Width="50"
                              SelectionChanged="filterComboBox_SelectionChanged">
                        <ComboBoxItem Content="Все брони" IsSelected="True" Tag="All"/>
                        <ComboBoxItem Content="──────────" IsEnabled="False"/>
                        <ComboBoxItem Content="📅 Текущие" Tag="Status_Current"/>
                        <ComboBoxItem Content="📅 Прошлые" Tag="Status_Past"/>
                        <ComboBoxItem Content="❌ Отменённые" Tag="Status_Canceled"/>
                    </ComboBox>
                    <Image Source="/Icon/filledFilter.png"
                           IsHitTestVisible="False"
                           Width="45"
                           Height="45"
                           VerticalAlignment="Top"
                           Margin="0 3 0 0"/>
                </Grid>

                <!-- Кнопка сброса фильтров -->
                <Button Content="✕ Сбросить"
                        Width="120"
                        Height="50"
                        Margin="20,0,0,0"
                        VerticalAlignment="Top"
                        Click="ResetFilters_Click"
                        FontSize="14"
                        Background="#f0f0f0"
                        BorderThickness="0"/>

            </StackPanel>


            <ListBox x:Name="RoomsListBox"
                     Margin="0 50 0 0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                     d:ItemsSource="{d:SampleData}"
                     Style="{DynamicResource ListBoxModernStyle}"
                     BorderThickness="0"
                     BorderBrush="{x:Null}">

                <!-- Располагаем карточки в ряд -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                               HorizontalAlignment="Left" Cursor=""/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <!-- Шаблон одной карточки -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <hc:Card Width="250"
                             Height="260"
                             BorderThickness="0"
                             Margin="15"
                             Padding="10"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Cursor="Hand"
                             MouseLeftButtonDown="Card_MouseLeftButtonDown">

                            <Image 
                                   Stretch="UniformToFill"
                                   Margin="2"/>

                            <hc:Card.Footer>
                                <StackPanel Margin="12,10">
                                    <!-- Номер комнаты -->
                                    <TextBlock Text="{Binding RoomNumber, StringFormat='№ {0}'}" 
                                               FontSize="16"
                                               Foreground="#e490a5"/>

                                    <!-- ФИО клиента -->
                                    <TextBlock Text="{Binding GuestName}" 
                                               FontSize="13"
                                               Foreground="Gray"
                                               Margin="0,2,0,5"/>

                                    <!-- Даты заезда и выезда -->
                                    <TextBlock FontSize="12" 
                                               Foreground="#666"
                                               Text="{Binding ArrivingDate, StringFormat='{}{0:dd.MM}'}"/>
                                        <TextBlock FontSize="12" 
                                               Foreground="#666"
                                               Text="{Binding DepartureDate, StringFormat='{}{0:dd.MM}'}"/>

                                    <!-- Статус бронирования -->
                                    <TextBlock Text="{Binding BookingStatusName}" 
                                           FontSize="11" 
                                           Foreground="{Binding BookingStatusId}"
                                           Margin="0,5,0,0"/>
                                </StackPanel>
                            </hc:Card.Footer>
                        </hc:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>
    </Grid>
</Page>