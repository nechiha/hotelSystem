<Page x:Class="курсовая.mainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:курсовая"
      mc:Ignorable="d"
      xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Главная страница"
      FontFamily="pack://application:,,,/Fonts/#Chiron GoRound TC">

    <Page.Resources>
        <local:RoomImageConverter x:Key="RoomImageConverter"/>
    </Page.Resources>

    <Grid>
        <!-- Верхняя панель с поиском и фильтром -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center">

            <hc:TextBox x:Name="mainSearchTB"
                        Height="50"
                        Width="1000"
                        Margin="0 30 0 0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        hc:InfoElement.Placeholder="Поиск"
                        FontSize="20"
                        TextChanged="mainSearchTB_TextChanged"/>
            <Grid>
                <ComboBox x:Name="filtersCB" 
                          Height="50"
                          VerticalAlignment="Top"
                          Margin="0 30 0 0"
                          Width="50"
                          SelectionChanged="filterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Все номера" IsSelected="True" Tag="All"/>
                    <ComboBoxItem Content="──────────" IsEnabled="False"/>
                    <ComboBoxItem Content="🏠 По типу номера" IsEnabled="False"/>
                    <ComboBoxItem Content="Одноместный" Tag="Type_1"/>
                    <ComboBoxItem Content="Двуместный" Tag="Type_2"/>
                    <ComboBoxItem Content="Трехместный" Tag="Type_3"/>
                    <ComboBoxItem Content="Четырехместный" Tag="Type_4"/>
                    <ComboBoxItem Content="──────────" IsEnabled="False"/>
                    <ComboBoxItem Content="🏢 По этажу" IsEnabled="False"/>
                    <ComboBoxItem Content="1 этаж" Tag="Floor_1"/>
                    <ComboBoxItem Content="2 этаж" Tag="Floor_2"/>
                    <ComboBoxItem Content="3 этаж" Tag="Floor_3"/>
                    <ComboBoxItem Content="4 этаж" Tag="Floor_4"/>
                    <ComboBoxItem Content="5 этаж" Tag="Floor_5"/>
                    <ComboBoxItem Content="──────────" IsEnabled="False"/>
                    <ComboBoxItem Content="💰 По цене" IsEnabled="False"/>
                    <ComboBoxItem Content="До 3000 ₽" Tag="Price_0_3000"/>
                    <ComboBoxItem Content="3000 - 5000 ₽" Tag="Price_3000_5000"/>
                    <ComboBoxItem Content="5000 - 10000 ₽" Tag="Price_5000_10000"/>
                    <ComboBoxItem Content="От 10000 ₽" Tag="Price_10000_999999"/>
                </ComboBox>
                <Image Source="/Icon/filledFilter.png"
                       IsHitTestVisible="False"
                       Width="45"
                       Height="45"
                       VerticalAlignment="Top"
                       Margin="0 34 0 0"/>
            </Grid>
            <Button x:Name="resetFiltersBtn" 
                    Content="✕ Сбросить"
                    ToolTip="Сбросить все фильтры"
                    hc:BorderElement.CornerRadius="5"
                    Width="120"
                    Height="50"
                    Margin="20,30,0,0"
                    VerticalAlignment="Top"
                    Click="resetFiltersBtn_Click"
                    FontSize="18"/>
        </StackPanel>

        <!-- ListBox с карточками номеров -->
        <ListBox x:Name="RoomsListBox"
                 Margin="0 150 0 0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                 d:ItemsSource="{d:SampleData}"
                 Style="{DynamicResource ListBoxModernStyle}"
                 BorderThickness="0"
                 BorderBrush="{x:Null}">

            <!-- Располагаем карточки в ряд -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                               HorizontalAlignment="Left" Cursor=""/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!-- Шаблон одной карточки -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <hc:Card Width="250"
                             Height="260"
                             BorderThickness="0"
                             Margin="15"
                             Padding="10"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Cursor="Hand"
                             MouseLeftButtonDown="Card_MouseLeftButtonDown">

                        <Image Source="{Binding roomImage, Converter={StaticResource RoomImageConverter}}"
                               Stretch="UniformToFill"
                               Height="140"
                               Margin="2"
                               ClipToBounds="True"/>

                        <hc:Card.Footer>
                            <StackPanel Margin="12,10">
                                <!-- номер комнаты -->
                                <TextBlock Text="{Binding roomNumber, StringFormat='№ {0}'}" 
                                           FontSize="16"
                                           Foreground="#e490a5"/>

                                <!-- цена -->
                                <TextBlock Text="{Binding price, StringFormat='{}{0:# ##0} ₽'}"                                           FontSize="18" 
                                           FontWeight="Bold"
                                           Foreground="#db6c88"/>

                                <!-- описание -->
                                <TextBlock Text="{Binding roomDescription}" 
                                           FontSize="12" 
                                           Foreground="gray"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </hc:Card.Footer>
                    </hc:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>