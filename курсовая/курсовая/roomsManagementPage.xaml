<Page x:Class="курсовая.roomsManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:курсовая"
      mc:Ignorable="d" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      hc:WindowAttach.IsDragElement="False"
      d:DesignHeight="1080" d:DesignWidth="1920"
      FontFamily="pack://application:,,,/Fonts/#Chiron GoRound TC"
      Title="Номерной фонд">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: заголовок + кнопки/поиск -->
        <StackPanel Grid.Row="0" 
                    Orientation="Vertical"
                    Margin="10">

            <TextBlock Text="Управление номерами"
                   FontSize="55"
                   Margin="0 60 0 20"
                   HorizontalAlignment="Center"
                   FontWeight="Medium"
                   Foreground="#e490a5"/>

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                        Margin="25">

                <Button x:Name="addRoomBtn"
                    Content="+ Добавить номер"
                    FontSize="20"
                    Width="240"
                    Height="45"
                    Foreground="White"
                    Background="#e490a5"
                    hc:BorderElement.CornerRadius="15"
                    Margin="20"
                    VerticalAlignment="Top"
                    Click="addRoomBtn_Click"/>

                <ComboBox x:Name="managmentFilterCB"
                      hc:InfoElement.Placeholder="Фильтры"
                      FontSize="20"
                      Style="{StaticResource ComboBoxExtend}"
                      Width="250"
                      Height="45"
                      Margin="20"
                      hc:BorderElement.CornerRadius="10"
                      VerticalAlignment="Top"/>

                <hc:TextBox x:Name="searchManagementRoomsTB"
                        Height="45"
                        Width="700"
                        Margin="20"
                        VerticalAlignment="Top"
                        hc:InfoElement.Placeholder="Поиск"
                        FontSize="20"
                        hc:BorderElement.CornerRadius="10"
                        TextChanged="searchManagementRoomsTB_TextChanged"/>
            </StackPanel>
        </StackPanel>

        <!-- DataGrid: тянется вниз, скроллится -->
        <DataGrid x:Name="workloadDataGrid"
          Grid.Row="1"
          Margin="50,15,50,50"
          HorizontalAlignment="Center"
          VerticalAlignment="Stretch"
          AutoGenerateColumns="False"
          HeadersVisibility="All"
          RowHeaderWidth="60"
          FontSize="18"
          CanUserAddRows="False"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          hc:BorderElement.CornerRadius="13">
            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="True" Width="150" FontSize="20"
                            CanUserResize="False"
                            Header="№ комнаты" Binding="{Binding roomNumber}"/>
                <DataGridTextColumn IsReadOnly="True" Width="150"
                            CanUserResize="False"
                            Header="Этаж" Binding="{Binding roomFloor}"/>
                <DataGridTextColumn IsReadOnly="True" Width="180"
                            CanUserResize="False"
                            Header="Вместимость" Binding="{Binding capacity}"/>
                <DataGridTextColumn IsReadOnly="True" Width="180"
                            CanUserResize="False"
                            Header="Категория" Binding="{Binding category}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
