<Page x:Class="курсовая.workloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:курсовая"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      hc:WindowAttach.IsDragElement="False"
      Title="Отчет по загрузке">


    <Grid>

        <StackPanel>

            <TextBlock Text="Загрузка за: "
                   FontSize="50"
                   Foreground="#e490a5"
                   HorizontalAlignment="Left"                 
                   Margin="50 70 0 0"/>
            <ComboBox x:Name="workloadPeriod"
                      hc:InfoElement.Placeholder="Текущий период"
                      Style="{StaticResource ComboBoxExtend}"
                      FontSize="20"
                      Margin="50 50 0 0"
                      Height="45"
                      Width="400"
                      HorizontalAlignment="Left"/>
            <DataGrid x:Name="workloadDataGrid"
                      Margin="50 50 0 0"
                      Width="auto"
                      HorizontalAlignment="Left"
                      AutoGenerateColumns="False"
                      HeadersVisibility="All" 
                      RowHeaderWidth="60">

                <DataGrid.Columns> <!--Binding="{Binding ...}"--> 
                    <DataGridTextColumn IsReadOnly="True" 
                                        Width="auto"
                                        FontSize="20"
                                        CanUserResize="False" 
                                        
                                        Header="Кол-во забронированных номеров"/>
                    <DataGridTextColumn IsReadOnly="True"
                                        Width="auto"
                                        HeaderStringFormat=""
                                        CanUserResize="False" 
                                        
                                        Header="Кол-во забронированных VIP номеров"/>
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>
        
    </Grid>
</Page>
