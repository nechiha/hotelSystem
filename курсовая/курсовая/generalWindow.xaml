<Window x:Class="курсовая.generalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:курсовая"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="Главное окно" Height="1080" Width="1920"
        ResizeMode="CanMinimize"
        WindowState="Maximized"
        Icon="/Icon/IconWithoutBackground.png"
        Foreground="White">
    
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.3*"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="0.15*"></RowDefinition>
        </Grid.RowDefinitions>

        <Line VerticalAlignment="Center"
              X1="100" Y1="850" 
              X2="100" Y2="0" 
              StrokeThickness="2" 
              Stroke="Pink"
              HorizontalAlignment="Right"
              Grid.RowSpan="3"/>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center">
            
            <Button x:Name="mainBtn"
                    Content="Главная"
                    FontSize="25"
                    Grid.Row="1"
                    Width="250"
                    Height="55"
                    Margin="5"
                    HorizontalAlignment="Center"
                    hc:BorderElement.CornerRadius="15"
                    Foreground="White"
                    Background="#e490a5"
                    Click="mainBtn_Click"/>

            <Button x:Name="workloadBtn"
                    Content="Загрузка"
                    FontSize="25"
                    Grid.Row="1"
                    Width="250"
                    Height="55"
                    Margin="5"
                    HorizontalAlignment="Center"
                    hc:BorderElement.CornerRadius="15"
                    Foreground="White"
                    Background="#e490a5"
                    Click="workloadBtn_Click"/>
            
            <Button x:Name="bookingHistoryBtn"
                    Content="История брони"
                    FontSize="25"
                    Grid.Row="1"
                    Width="250"
                    Height="55"
                    Margin="5"
                    HorizontalAlignment="Center"
                    hc:BorderElement.CornerRadius="15"
                    Foreground="White"
                    Background="#e490a5"
                    Click="bookingHistoryBtn_Click"/>

            <Button x:Name="roomsManagementBtn"
                    Content="Управление номерами"
                    FontSize="22"
                    Grid.Row="1"
                    Width="250"
                    Height="55"
                    Margin="5"
                    HorizontalAlignment="Center"
                    hc:BorderElement.CornerRadius="15"
                    Foreground="White"
                    Background="#e490a5"
                    Click="roomsManagementBtn_Click"/>

            <Button x:Name="rateBtn"
                    Content="Тариф"
                    FontSize="25"
                    Grid.Row="1"
                    Width="250"
                    Height="55"
                    Margin="5"
                    HorizontalAlignment="Center"
                    hc:BorderElement.CornerRadius="15"
                    Foreground="White"
                    Background="#e490a5"
                    Click="rateBtn_Click"/>
        </StackPanel>

        <Button x:Name="exitBtn"
                Content="Выход"
                FontSize="25"
                Grid.Row="2"
                Width="250"
                Height="40"
                HorizontalAlignment="Center"
                hc:BorderElement.CornerRadius="10"
                Click="exitBtn_Click"/>

        
        
        <Frame x:Name="generalFrame"
               Grid.Column="1"
               Grid.RowSpan="3"
               BorderBrush="{x:Null}"
               Source="mainPage.xaml"
               NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>
