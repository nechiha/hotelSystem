<Window x:Class="курсовая.bookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:курсовая"
        mc:Ignorable="d"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        ResizeMode="NoResize"
        Title="Бронирование" Height="700" Width="1150"
        WindowStartupLocation="CenterScreen"
        Icon="/Icon/IconWithoutBackground.png"
        FontFamily="pack://application:,,,/Fonts/#Chiron GoRound TC">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Создание брони"
                   FontSize="40"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="20"
                   Grid.ColumnSpan="2"/>

        <StackPanel Grid.Row="1"
                    Margin="35">

            <TextBox x:Name="insertSurname"
                     Width="300"
                     Style="{StaticResource TextBoxExtend}" 
                     hc:InfoElement.Title="Фамилия"
                     ToolTip="Введите фамилию гостя"
                     FontSize="15"
                     VerticalAlignment="Center"
                     Margin="5"
                     TextChanged="ValidateInput"/>
            <TextBox x:Name="insertName"
                     Width="300"
                     Style="{StaticResource TextBoxExtend}" 
                     hc:InfoElement.Title="Имя"
                     ToolTip="Введите имя гостя"
                     FontSize="15"
                     VerticalAlignment="Center"
                     Margin="5"
                     TextChanged="ValidateInput"/>
            <TextBox x:Name="insertPatronomyc"
                     Width="300"
                     Style="{StaticResource TextBoxExtend}" 
                     hc:InfoElement.Title="Отчество" 
                     ToolTip="Введите отчество гостя (необязательно)"                     
                     FontSize="15"
                     VerticalAlignment="Center"
                     Margin="5"
                     TextChanged="ValidateInput"/>
            <TextBox x:Name="insertPhone"
                     Width="300"
                     Style="{StaticResource TextBoxExtend}"
                     hc:InfoElement.Title="Телефон"
                     ToolTip="Введите номер телефона гостя"        
                     FontSize="15"
                     VerticalAlignment="Center"
                     Margin="5"
                     MaxLength="12"
                     PreviewTextInput="Phone_PreviewTextInput"
                     DataObject.Pasting="Phone_Pasting"/>
            <ComboBox x:Name="peopleAmountCB"
                      Width="300"
                      Style="{StaticResource ComboBoxExtend}" 
                      hc:InfoElement.Title="Кол-во персон"
                      ToolTip="Введите кол-во гостей в номере"                    
                      FontSize="15"
                      VerticalAlignment="Center"
                      Margin="5"
                      SelectionChanged="ValidateInput"/>
            <hc:DateTimePicker x:Name="arriveDatePick"
                               Width="300"                         
                               hc:InfoElement.Title="Заезд"
                               ToolTip="Введите дату и время заезда в номер"
                               Style="{StaticResource DateTimePickerExtend}"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="5"
                               SelectedDateTimeChanged="arriveDatePick_SelectedDateTimeChanged"/>

            <hc:DateTimePicker x:Name="departureDatePick"
                               Width="300"                         
                               hc:InfoElement.Title="Выезд"
                               ToolTip="Введите дату и время выезда из номера"
                               Style="{StaticResource DateTimePickerExtend}"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="5"
                               SelectedDateTimeChanged="departureDatePick_SelectedDateTimeChanged"/>
            <StackPanel Orientation="Horizontal"
                        Margin="30">
                
                <TextBlock Text="Общая стоимость: "
                           FontSize="15"
                           FontWeight="Medium"/>
                <!--во втором текстблоке биндинг-->
                <TextBlock x:Name="totalPriceText" 
                           Text="0.00 ₽"
                           FontSize="15"
                           FontWeight="Medium"/>
            </StackPanel>
            
        </StackPanel>

        <StackPanel x:Name="optionsPanel"
            Grid.Row="1"
            Grid.Column="1"
            Margin="50">

            <!-- Выбор опции + кнопка добавления -->
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="insertOptionCB"
                  Width="250"
                  Style="{StaticResource ComboBoxExtend}"
                  hc:InfoElement.Title="Доп. услуга"
                  FontSize="15"
                  VerticalAlignment="Center"
                  ToolTip="Выберите услугу и нажмите +"/>
                <Button x:Name="addOptionBtn"
                Content="+"
                Height="35"
                Width="35"
                Margin="10 0 0 0"
                FontSize="15"
                VerticalAlignment="Bottom"
                hc:BorderElement.CornerRadius="20"
                Foreground="White"
                Background="#e490a5"
                ToolTip="Добавить услугу к брони"
                Click="addOptionBtn_Click"/>
            </StackPanel>

            <!-- Список выбранных опций -->
            <TextBlock Text="Выбранные услуги:"
               FontSize="14"
               Foreground="Gray"
               Margin="0 20 0 5"/>

            <ItemsControl x:Name="selectedOptionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF0F4"
                        CornerRadius="10"
                        Margin="0 0 0 8"
                        Padding="10 6">
                            <Grid Width="290">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                   Text="{Binding optionName}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1"
                                   Text="{Binding price, StringFormat='{}{0:0} ₽'}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#db6c88"
                                   VerticalAlignment="Center"
                                   Margin="10 0"/>
                                <Button Grid.Column="2"
                                Content="✕"
                                Width="24" Height="24"
                                FontSize="12"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="Gray"
                                Cursor="Hand"
                                ToolTip="Убрать услугу"
                                Tag="{Binding optionId}"
                                Click="removeOptionBtn_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"                    
                    Width="1150">

            <Button x:Name="escapeFromBookingBtn"
                    Content="Назад"
                    FontSize="15"
                    Width="130"
                    Height="29"
                    Margin="10"                   
                    hc:BorderElement.CornerRadius="10"
                    Click="escapeFromBookingBtn_Click"/>

            <Button x:Name="toBookBtn"
                    Content="Забронировать"
                    FontSize="17"
                    Width="200"
                    Height="45"
                    Margin="315 0 0 15"
                    Foreground="White"
                    Background="#e490a5"                   
                    hc:BorderElement.CornerRadius="15"
                    Click="toBookBtn_Click"/>
            
        </StackPanel>
    </Grid>
</Window>
