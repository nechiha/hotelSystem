<Window x:Class="курсовая.createRateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:курсовая"
        mc:Ignorable="d"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        ResizeMode="NoResize"
        Title="Создание тарифа" Height="700" Width="1150"
        WindowStartupLocation="CenterScreen"
        Icon="/Icon/IconWithoutBackground.png"
        FontFamily="pack://application:,,,/Fonts/#Chiron GoRound TC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.4*"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="0.3*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="top"
                    HorizontalAlignment="Center"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Grid.RowSpan="2"
                    Width="1000"
                    Height="250">
            <TextBlock Text="Создание тарифа"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       Margin="0 25"/>
            <TextBox x:Name="insertRateNameTB"
                     Margin="60 40"
                     Width="500"
                     Height="35"
                     Style="{StaticResource TextBoxExtend}"
                     hc:BorderElement.CornerRadius="10"
                     hc:InfoElement.Placeholder="Название тарифа"
                     ToolTip="Введите название тарифа"
                     FontSize="15"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"/>
            <TextBlock Text="Стоимость:"
                       FontSize="15"
                       Margin="65 0 0 0"/>
        </StackPanel>
        

        <StackPanel Grid.Row="1"
                     VerticalAlignment="Center">

            <TextBox x:Name="singleRoomPriceTB"
                     Height="35"
                     hc:BorderElement.CornerRadius="10"                        
                     Width="300"
                     hc:InfoElement.Placeholder="1-местный №"
                     ToolTip="Введите стоимость одноместного номера"
                     hc:InfoElement.Necessary="True"
                     Style="{StaticResource TextBoxExtend}"
                     FontSize="15"
                     Margin="10"
                     PreviewTextInput="PriceTB_PreviewTextInput"
                     DataObject.Pasting="PriceTB_Pasting"/>
            <TextBox x:Name="doubleRoomPriceTB"
                     Height="35"
                     hc:BorderElement.CornerRadius="10"                        
                     Width="300"
                     hc:InfoElement.Placeholder="2-местный №"
                     ToolTip="Введите стоимость двуместного номера"
                     hc:InfoElement.Necessary="True"
                     Style="{StaticResource TextBoxExtend}"
                     FontSize="15"
                     Margin="10"
                     PreviewTextInput="PriceTB_PreviewTextInput"
                     DataObject.Pasting="PriceTB_Pasting"/>
            <TextBox x:Name="tripleRoomPriceTb"
                     Height="35"
                     hc:BorderElement.CornerRadius="10"                        
                     Width="300"
                     hc:InfoElement.Placeholder="3-местный №"
                     ToolTip="Введите стоимость трехместного номера"
                     hc:InfoElement.Necessary="True"
                     Style="{StaticResource TextBoxExtend}"
                     FontSize="15"
                     Margin="10"
                     PreviewTextInput="PriceTB_PreviewTextInput"
                     DataObject.Pasting="PriceTB_Pasting"/>
            <TextBox x:Name="quadrupleRoomPriceTB"
                     Height="35"
                     hc:BorderElement.CornerRadius="10"                        
                     Width="300"
                     hc:InfoElement.Placeholder="4-местный №"
                     ToolTip="Введите стоимость четырехместного номера"
                     hc:InfoElement.Necessary="True"
                     Style="{StaticResource TextBoxExtend}"
                     FontSize="15"
                     Margin="10"
                     />

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        ToolTip="Отметьте, входит ли завтрак в стоимость тарифа">
                <TextBlock Text="Завтрак"
                           FontSize="15"
                           Margin="10"/>
                <ToggleButton x:Name="isBreakfastIncludedTglBtn" 
                              Style="{StaticResource ToggleButtonSwitch}"
                              Background="Pink"
                              Checked="isBreakfastIncludedTglBtn_Checked"
                              Unchecked="isBreakfastIncludedTglBtn_Unchecked"/>
            </StackPanel>
            
        </StackPanel>


        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBox x:Name="singleVIPRoomPriceTB"
                     Height="35"
                     hc:BorderElement.CornerRadius="10"                        
                     Width="300"
                     hc:InfoElement.Placeholder="1-местный VIP"
                     ToolTip="Введите стоимость одноместного VIP номера"
                     hc:InfoElement.Necessary="False"
                     Style="{StaticResource TextBoxExtend}"
                     FontSize="15"
                     Margin="10"
                     PreviewTextInput="PriceTB_PreviewTextInput"
                     DataObject.Pasting="PriceTB_Pasting"/>
            <TextBox x:Name="doubleVIPRoomPriceTB"
                     Height="35"
                     hc:BorderElement.CornerRadius="10"                        
                     Width="300"
                     hc:InfoElement.Placeholder="2-местный VIP"
                     ToolTip="Введите стоимость двуместного VIP номера"
                     hc:InfoElement.Necessary="False"
                     Style="{StaticResource TextBoxExtend}"
                     FontSize="15"
                     Margin="10"
                     PreviewTextInput="PriceTB_PreviewTextInput"
                     DataObject.Pasting="PriceTB_Pasting"/>
            <TextBox x:Name="tripleVIPRoomPriceTb"
                     Height="35"
                     hc:BorderElement.CornerRadius="10"                        
                     Width="300"
                     hc:InfoElement.Placeholder="3-местный VIP"
                     ToolTip="Введите стоимость трехместного VIP номера"
                     hc:InfoElement.Necessary="False"
                     Style="{StaticResource TextBoxExtend}"
                     FontSize="15"
                     Margin="10"
                     PreviewTextInput="PriceTB_PreviewTextInput"
                     DataObject.Pasting="PriceTB_Pasting"/>
            <TextBox x:Name="quadrupleVIPRoomPriceTB"
                     Height="35"
                     hc:BorderElement.CornerRadius="10"                        
                     Width="300"
                     hc:InfoElement.Placeholder="4-местный VIP"
                     ToolTip="Введите стоимость четырехместного VIP номера"
                     hc:InfoElement.Necessary="False"
                     Style="{StaticResource TextBoxExtend}"
                     FontSize="15"
                     Margin="10"
                     PreviewTextInput="PriceTB_PreviewTextInput"
                     DataObject.Pasting="PriceTB_Pasting"/>
            
             <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        ToolTip="Отметьте, входит ли завтрак в стоимость тарифа">

                <TextBlock Text="Завтрак"
                           FontSize="15"
                           Margin="10"
                           />
                <ToggleButton x:Name="isVIPBreakfastIncludedTglBtn" 
                              Style="{StaticResource ToggleButtonSwitch}"
                              Background="Pink"
                              Checked="isVIPBreakfastIncludedTglBtn_Checked"
                              Unchecked="isVIPBreakfastIncludedTglBtn_Unchecked"/>
            </StackPanel>
            
        </StackPanel>

        <Button x:Name="saveNewRateBtn"
                Content="Сохранить"
                Grid.ColumnSpan="2"
                Grid.Row="2"
                FontSize="25"
                Width="250"
                Height="55"
                Foreground="White"
                Background="#e490a5"
                hc:BorderElement.CornerRadius="15"
                Click="saveNewRateBtn_Click"/>

    </Grid>
</Window>
