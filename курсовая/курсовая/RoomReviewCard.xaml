<UserControl x:Class="курсовая.RoomReviewCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:курсовая"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             hc:WindowAttach.IsDragElement="False"
             d:DesignHeight="1080" d:DesignWidth="1920"
             FontFamily="pack://application:,,,/Fonts/#Chiron GoRound TC">


    <Grid>
        <StackPanel Grid.Column="1">

            <TextBlock Text="{Binding roomDescription, FallbackValue='Описание отсутствует'}"
                       TextWrapping="Wrap"
                       LineHeight="25"
                       LineStackingStrategy="BlockLineHeight"
                       TextAlignment="Left"
                       FontSize="20"
                       Margin="10 120 20 0"
                       HorizontalAlignment="Left"/>
            <!-- ТУДУ: добавить текст
            опции могут быть внесены в бронь за отдельную плату-->
        </StackPanel>
    </Grid>
</UserControl>
