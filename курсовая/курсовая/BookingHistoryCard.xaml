<UserControl x:Class="курсовая.BookingHistoryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:курсовая"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             hc:WindowAttach.IsDragElement="False"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <Grid>
        <TextBlock Grid.Row="0" 
                   Grid.Column="0" 
                   Text="Кем:" 
                   FontWeight="Bold"
                   Margin="0,0,10,5"/>
        <TextBlock Grid.Row="0" 
                   Grid.Column="1" 
                   Text="{Binding GuestName}"
                   Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1" 
                   Grid.Column="0" Text="Забронировано:" 
                   FontWeight="Bold" Margin="0,0,10,5"/>
        <TextBlock Grid.Row="1" Grid.Column="1" 
                   Text="{Binding BookingDate}"
                   Margin="0,0,0,5"/>

        <TextBlock Grid.Row="2" 
                   Grid.Column="0" 
                   Text="Проведено дней:" 
                   FontWeight="Bold"
                   Margin="0,0,10,5"/>
        <TextBlock Grid.Row="2" 
                   Grid.Column="1" 
                   Text="{Binding DaysSpent}"
                   Margin="0,0,0,5"/>

        <TextBlock Grid.Row="3" 
                   Grid.Column="0" 
                   Text="Доп. опции:" 
                   FontWeight="Bold" 
                   Margin="0,0,10,5"/>
        <TextBlock Grid.Row="3" 
                   Grid.Column="1" 
                   Text="{Binding ExtraOptions}"
                   TextWrapping="Wrap"/>

        <Button x:Name="deleteBookingBtn"
                Content="Отменить"/>
    </Grid>
</UserControl>
