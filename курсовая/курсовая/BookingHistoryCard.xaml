<UserControl x:Class="курсовая.BookingHistoryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:курсовая"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             hc:WindowAttach.IsDragElement="False"
             d:DesignHeight="1080" d:DesignWidth="1920"
             FontFamily="pack://application:,,,/Fonts/#Chiron GoRound TC">
    <Grid>
        <StackPanel>

            <TextBlock FontSize="19"
                   Text="Кем:" 
                   FontWeight="Bold"
                   Margin="0,0,10,5"/>
            <TextBlock x:Name="guestNameTB"
                   FontSize="20"
                   Text="{Binding guestName}"                  
                   Margin="10"/>

        <TextBlock FontSize="19"
                   Text="Забронировано:" 
                   FontWeight="Bold" 
                   Margin="0,0,10,5"/>
        <TextBlock x:Name="bookingDateTB"
                   FontSize="19"
                   Text="{Binding arrivingDate}"
                   Margin="10"/>

        <TextBlock FontSize="19"
                   Text="Проведено дней:" 
                   FontWeight="Bold"
                   Margin="0,0,10,5"/>
        <TextBlock x:Name="daysSpentTB"
                   FontSize="19"
                   Text="{Binding daysSpent}"
                   Margin="10"/>

        <TextBlock FontSize="19"
                   Text="Доп. опции:" 
                   FontWeight="Bold" 
                   Margin="0,0,10,5"/>
        <TextBlock x:Name="extraOptionsTB"
                   FontSize="19"
                   Text="{Binding extraOptions}"
                   TextWrapping="Wrap"
                   Margin="10"/>

        <Button x:Name="deleteBookingBtn"
                Content="Отменить"
                Height="40"
                Width="150"
                FontSize="19"/>      
        </StackPanel>

    </Grid>
</UserControl>
