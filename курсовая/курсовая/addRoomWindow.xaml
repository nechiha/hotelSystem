<Window x:Class="курсовая.addRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:курсовая"
        mc:Ignorable="d"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        ResizeMode="NoResize"
        Title="Добавление номера" Height="700" Width="1150"
        WindowStartupLocation="CenterScreen"
        Icon="/Icon/IconWithoutBackground.png"
        FontFamily="pack://application:,,,/Fonts/#Chiron GoRound TC">
    <Grid>
        
        <TextBlock Text="Создание номера"
                   FontSize="40"
                   FontWeight="Medium"
                   HorizontalAlignment="Center"
                   Margin="50"/>
        
        <StackPanel VerticalAlignment="Bottom">
            
            <ComboBox x:Name="chooseFloorCB"
                      Height="35"
                      hc:BorderElement.CornerRadius="10"                      
                      Width="300"
                      hc:InfoElement.Placeholder="Этаж"
                      Style="{StaticResource ComboBoxExtend}"
                      FontSize="15"
                      VerticalAlignment="Center"
                      Margin="10"/>
            <ComboBox x:Name="chooseCapacityCB"
                      Height="35"
                      hc:BorderElement.CornerRadius="10"
                      Width="300"
                      hc:InfoElement.Placeholder="Вместимость"
                      Style="{StaticResource ComboBoxExtend}"
                      FontSize="15"
                      VerticalAlignment="Center"
                      Margin="10"/>
            <ComboBox x:Name="chooseCategoryCB"
                      Height="35"
                      hc:BorderElement.CornerRadius="10"
                      Width="300"
                      hc:InfoElement.Placeholder="Категория"
                      Style="{StaticResource ComboBoxExtend}"
                      FontSize="15"
                      VerticalAlignment="Center"
                      Margin="10"/>
            <TextBox x:Name="insertRoomTB"
                      Height="35"
                      hc:BorderElement.CornerRadius="10"                        
                      Width="300"
                      hc:InfoElement.Placeholder="№ комнаты"
                      Style="{StaticResource TextBoxExtend}"
                      FontSize="15"
                      VerticalAlignment="Center"
                      Margin="10"/>

            <TextBox x:Name="insertDescriptionTB"
                     Height="100"
                     Width="300"
                     hc:BorderElement.CornerRadius="10"
                     hc:InfoElement.Placeholder="Описание"
                     Style="{StaticResource TextBoxExtend}"
                     FontSize="15"
                     Margin="10"
                     VerticalContentAlignment="Top"
                     Padding="8"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"/>

            <hc:ImageSelector x:Name="imageSelector" 
                              Height="100"
                              Width="200"/>

            <Button x:Name="saveRoomBtn"
                    Content="Сохранить"
                    FontSize="25"
                    Width="250"
                    Height="55"
                    Foreground="White"
                    Background="#e490a5"
                    Margin="0 20"
                    hc:BorderElement.CornerRadius="15"
                    Click="saveRoomBtn_Click_1"/>
            
            
            
            
            
            

        </StackPanel>
    </Grid>
</Window>
